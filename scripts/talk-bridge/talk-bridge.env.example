# ~/.talk-bridge.env (chmod 600) — nicht ins Repo
NEXTCLOUD_URL=https://cloud.hodelweb.ch
# Geheimnis des Talk-Bots 3 («OpenClaw»), bisher channels.nextcloud-talk.botSecret in ~/.openclaw/openclaw.json
TALK_BOT_SECRET=
HERMES_URL=http://127.0.0.1:8642
# = API_SERVER_KEY in ~/.hermes/.env
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT=900
